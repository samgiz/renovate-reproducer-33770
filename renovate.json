{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "automergeType": "pr",
  "automergeSchedule": ["at any time"],
  "schedule": ["* * 1 1 *"],
  "timezone": "UTC",
  "updateNotScheduled": false,
  "packageRules": [
    {
      "matchPackageNames": ["lodash"],
      "automerge": true
    }
  ]
}
